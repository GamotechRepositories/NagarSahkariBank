PORT=5000
MONGODB_URI=

# Fast2SMS OTP — API key required
# Get key: Fast2SMS → Dev API
FAST2SMS_API_KEY=

# Leave empty to use local mode (works without OTP ID)
# When you create Smart OTP in Fast2SMS panel, paste the OTP ID here
FAST2SMS_OTP_ID=

# Optional: force mode — local (no OTP ID) or smart (needs OTP ID)
# FAST2SMS_MODE=local

FAST2SMS_OTP_LENGTH=6
FAST2SMS_OTP_EXPIRY_MINUTES=10

# Optional: relaxes Aadhaar Verhoeff checks in local KYC testing only (does NOT bypass OTP)
MSG91_DEBUG=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
